{
  "name": "jquants-metrics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "$npm_execpath run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:sync-from-prod": "tsx --env-file=.dev.vars scripts/sync-from-prod.ts",
    "sync:daily:prices": "tsx scripts/daily-prices-sync.ts",
    "sync:daily:valuations": "tsx scripts/daily-valuations-sync.ts",
    "sync:edinet:watch": "tsx scripts/edinet-watch-sync.ts",
    "sync:phase-a:edinet": "tsx scripts/sync-phase-a-edinet.ts",
    "sync:backfill:financials": "tsx scripts/backfill-financials.ts",
    "sync:backfill:phase-a-financials": "tsx scripts/backfill-phase-a-financials.ts",
    "audit:phase-a-inputs": "tsx scripts/audit-phase-a-inputs.ts",
    "sync:backfill:prices": "tsx scripts/backfill-prices.ts",
    "sync:backfill:valuations": "tsx scripts/backfill-valuations.ts",
    "import:stock-themes": "tsx scripts/import-stock-themes.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.40.1",
    "fflate": "^0.8.3",
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "drizzle-kit": "^0.30.4",
    "neonctl": "^2.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.18",
    "wrangler": "^4.4.0"
  }
}
